msgid_plural "Sent {days} days ago, no reply yet"
msgstr[0] "Vor {days} Tag gesendet, noch keine Antwort"
msgstr[1] "Vor {days} Tagen gesendet, noch keine Antwort"

#: sync/src/mailbox.rs:1566
msgid "The server has not sent this message yet."
msgstr "Der Server hat diese Nachricht noch nicht gesendet."

#: sync/src/mailbox.rs:1575
msgid "Sends {when}."
msgstr "Wird {when} gesendet."

#: sync/src/mailbox.rs:1576
msgid "The server sends it even if Penguin Mail is closed."
msgstr "Der Server sendet sie, auch wenn Penguin Mail geschlossen ist."

#: sync/src/mailbox.rs:1578
msgid "Sends {when}"
msgstr "Wird {when} gesendet"

#: sync/src/mailbox.rs:1585
msgid "Check Sent. Penguin Mail could not confirm it went out."
msgstr ""
"Sehen Sie in „Gesendet“ nach. Penguin Mail konnte das Senden nicht "
"bestätigen."

#: sync/src/mailbox.rs:1588
msgid "Canceled in another app."
msgstr "In einer anderen App abgebrochen."

#: sync/src/mailbox.rs:1590
msgid "Not sent"
msgstr "Nicht gesendet"

#: sync/src/mailbox.rs:1597
msgid "{problem}. Trying again {when}"
msgstr "{problem}. Neuer Versuch {when}"

#: sync/src/mailbox.rs:1604
msgid "{problem}. Penguin Mail stopped trying"
msgstr "{problem}. Penguin Mail hat es aufgegeben"

#: sync/src/outbox.rs:93
msgid "This message was canceled in another app and is no longer in Drafts."
msgstr ""
"Diese Nachricht wurde in einer anderen App abgebrochen und ist nicht mehr in "
"den Entwürfen."

#: sync/src/outbox.rs:99
msgid ""
"The server still holds this message and could not be asked to let it go. Try "
"again later."
msgstr ""
"Der Server hält diese Nachricht noch zurück und konnte nicht gebeten werden, "
"sie freizugeben. Versuchen Sie es später erneut."

#: sync/src/outbox.rs:597
msgid "Waiting for the account to switch to JMAP"
msgstr "Wartet auf den Wechsel des Kontos zu JMAP"

#: sync/src/outbox.rs:1109
msgid "The server could not be asked to let go of the message."
msgstr "Der Server konnte nicht gebeten werden, die Nachricht freizugeben."

#: sync/src/passwords.rs:22
msgid "The keyring refused: {reason}"
msgstr "Der Schlüsselbund hat abgelehnt: {reason}"

#: sync/src/rules/forward.rs:28
msgid "A rule on this computer forwarded the attached message from {address}."
msgstr ""
"Eine Regel auf diesem Rechner hat die angehängte Nachricht von {address} "
"weitergeleitet."

#: sync/src/services/caldav.rs:387
msgid "An event needs an ID to be imported."
msgstr "Ein Termin benötigt eine ID, um importiert zu werden."

#: sync/src/services/caldav.rs:408
msgid "A CalDAV calendar cannot store attached files."
msgstr "Ein CalDAV-Kalender kann keine angehängten Dateien speichern."

#: sync/src/services/caldav.rs:412
msgid "A CalDAV calendar has no files to share."
msgstr "Ein CalDAV-Kalender hat keine Dateien zum Teilen."

#: sync/src/services/caldav.rs:442
msgid "You are not a guest of this event."
msgstr "Sie sind kein Gast dieses Termins."

#: sync/src/services/caldav.rs:446
msgid "Penguin Mail cannot change the calendar list of a CalDAV server."
msgstr "Penguin Mail kann die Kalenderliste eines CalDAV-Servers nicht ändern."

#: sync/src/services/finding.rs:197
msgid "Penguin Mail reaches calendar and contact servers over HTTPS only."
msgstr "Penguin Mail erreicht Kalender- und Kontakteserver nur über HTTPS."

#: sync/src/services/imap/outgoing.rs:85
msgid "The message names nobody to send it to."
msgstr "Die Nachricht nennt niemanden, an den sie gesendet werden soll."

#: sync/src/services/jmap/calendar.rs:201
msgid "the title"
msgstr "den Titel"

#: sync/src/services/jmap/calendar.rs:202
msgid "the time"
msgstr "die Uhrzeit"

#: sync/src/services/jmap/calendar.rs:203
msgid "the repeat"
msgstr "die Wiederholung"

#: sync/src/services/jmap/calendar.rs:204
msgid "the place"
msgstr "den Ort"

#: sync/src/services/jmap/calendar.rs:205
msgid "the meeting link"
msgstr "den Besprechungslink"

#: sync/src/services/jmap/calendar.rs:206
msgid "the notes"
msgstr "die Notizen"

#: sync/src/services/jmap/calendar.rs:207
msgid "the reminders"
msgstr "die Erinnerungen"

#: sync/src/services/jmap/calendar.rs:208
msgid "the guests"
msgstr "die Gäste"

#: sync/src/services/jmap/calendar.rs:209
msgid "your answer"
msgstr "Ihre Antwort"

#: sync/src/services/jmap/calendar.rs:210
msgid "the color"
msgstr "die Farbe"

#: sync/src/services/jmap/calendar.rs:211
msgid "the privacy"
msgstr "die Sichtbarkeit"

#: sync/src/services/jmap/calendar.rs:212
msgid "whether it shows as busy"
msgstr "ob der Termin als beschäftigt angezeigt wird"

#: sync/src/services/jmap/calendar.rs:213
msgid "the status"
msgstr "den Status"

#: sync/src/services/jmap/calendar.rs:424
msgid "The server kept the event but did not say its id."
msgstr "Der Server hat den Termin gespeichert, aber seine ID nicht genannt."

#: sync/src/services/jmap/calendar.rs:727
msgid "Penguin Mail cannot attach files to events on this JMAP calendar."
msgstr ""
"Penguin Mail kann in diesem JMAP-Kalender keine Dateien an Termine anhängen."

#: sync/src/services/jmap/calendar.rs:731
msgid "This JMAP calendar has no files to share."
msgstr "Dieser JMAP-Kalender hat keine Dateien zum Teilen."

#: sync/src/services/jmap/calendar.rs:791
msgid "Penguin Mail cannot change the calendar list of a JMAP server."
msgstr "Penguin Mail kann die Kalenderliste eines JMAP-Servers nicht ändern."

#: sync/src/services/jmap/errors.rs:21
msgid "The server does not allow this."
msgstr "Der Server erlaubt das nicht."

#: sync/src/services/jmap/errors.rs:22
msgid "The server refused this request."
msgstr "Der Server hat diese Anfrage abgelehnt."

#: sync/src/services/jmap/errors.rs:23
msgid "The server could not take this request."
msgstr "Der Server konnte diese Anfrage nicht annehmen."

#: sync/src/services/jmap/jscal.rs:1127
msgid ""
"Penguin Mail cannot read how this event repeats, so it cannot change the "
"repeat. Change it in the app that set it."
msgstr ""
"Penguin Mail kann nicht lesen, wie sich dieser Termin wiederholt, und kann "
"die Wiederholung daher nicht ändern. Ändern Sie sie in der App, die sie "
"festgelegt hat."

#: sync/src/services/jmap/jscal.rs:1131
msgid "Penguin Mail cannot save this repeat to a JMAP calendar."
msgstr ""
"Penguin Mail kann diese Wiederholung nicht in einem JMAP-Kalender speichern."

#: sync/src/services/jmap/mod.rs:263
msgid "This server keeps no colors for its mailboxes."
msgstr "Dieser Server speichert keine Farben für seine Postfächer."

#: sync/src/services/jmap/mod.rs:336
msgid "This server files sent mail itself."
msgstr "Dieser Server legt gesendete E-Mails selbst ab."

#: sync/src/services/jmap/mod.rs:437
msgid "The server made an address Penguin Mail cannot read."
msgstr ""
"Der Server hat eine Adresse erstellt, die Penguin Mail nicht lesen kann."

#: sync/src/services/jmap/outgoing.rs:70
msgid "The server does not let this account send from {address}."
msgstr "Der Server erlaubt diesem Konto nicht, von {address} zu senden."

#: sync/src/services/jmap/outgoing.rs:71
msgid "The server does not let this account send mail now."
msgstr "Der Server erlaubt diesem Konto derzeit nicht, E-Mails zu senden."

#: sync/src/services/jmap/outgoing.rs:72
msgid "The message names more recipients than the server sends to at once."
msgstr "Die Nachricht hat mehr Empfänger, als der Server auf einmal annimmt."

#: sync/src/services/jmap/outgoing.rs:73
msgid "The server could not send to one of the recipients."
msgstr "Der Server konnte nicht an einen der Empfänger senden."

#: sync/src/services/jmap/outgoing.rs:74
msgid "The message is larger than the server sends."
msgstr "Die Nachricht ist größer als das, was der Server versendet."

#: sync/src/services/jmap/outgoing.rs:75
msgid "The server could not read the message to send it."
msgstr "Der Server konnte die Nachricht nicht lesen, um sie zu senden."

#: sync/src/services/jmap/outgoing.rs:87
msgid ""
"This account can read mail but not send it: its sign-in has no access to "
"sending."
msgstr ""
"Dieses Konto kann E-Mails lesen, aber nicht senden: Seine Anmeldung hat "
"keinen Zugriff auf das Senden."

#: sync/src/services/jmap/outgoing.rs:100
msgid "This account has no address the server lets it send from."
msgstr ""
"Dieses Konto hat keine Adresse, von der aus der Server es senden lässt."

#: sync/src/services/jmap/outgoing.rs:120
msgid ""
"The server has neither a Drafts nor a Sent mailbox to keep the message in."
msgstr ""
"Der Server hat weder ein Postfach für Entwürfe noch eines für gesendete E-"
"Mails, in dem die Nachricht bleiben kann."

#: sync/src/services/jmap/outgoing.rs:139
msgid "The server has no Drafts mailbox."
msgstr "Der Server hat kein Postfach für Entwürfe."

#: sync/src/services/jmap/outgoing.rs:147
msgid ""
"The server already keeps this exact message outside Drafts, so it cannot "
"also keep it as a draft."
msgstr ""
"Der Server bewahrt genau diese Nachricht bereits außerhalb der Entwürfe auf "
"und kann sie deshalb nicht zusätzlich als Entwurf speichern."

#: sync/src/services/jmap/sieve.rs:32
msgid "The server did not take the rules."
msgstr "Der Server hat die Regeln nicht angenommen."

#: sync/src/services/jmap/writes.rs:95
msgid "The server has no mailbox for this."
msgstr "Der Server hat dafür kein Postfach."

#: sync/src/services/jmap/writes.rs:122
msgid "This server does not sort mail into categories."
msgstr "Dieser Server sortiert E-Mails nicht in Kategorien."

#: sync/src/services/jmap/writes.rs:150
msgid ""
"A message must stay in at least one mailbox, and this server has no Archive."
msgstr ""
"Eine Nachricht muss in mindestens einem Postfach bleiben, und dieser Server "
"hat kein Archiv."

#: sync/src/services/local.rs:29
msgid "This rule is read-only, so Penguin Mail leaves it as it is."
msgstr ""
"Diese Regel ist schreibgeschützt, daher lässt Penguin Mail sie, wie sie ist."

#: sync/src/services/microsoft/calendar.rs:359
msgid "Outlook cannot repeat an event that way."
msgstr "Outlook kann einen Termin nicht auf diese Weise wiederholen."

#: sync/src/services/microsoft/calendar.rs:651
msgid "Outlook cannot attach a file to an event."
msgstr "Outlook kann keine Datei an einen Termin anhängen."

#: sync/src/services/microsoft/calendar.rs:655
msgid "Outlook has no files to share."
msgstr "Outlook hat keine Dateien zum Teilen."

#: sync/src/services/microsoft/calendar.rs:664
msgid "Outlook cannot move an event to another calendar."
msgstr "Outlook kann einen Termin nicht in einen anderen Kalender verschieben."

#. What Outlook has no call for is a refusal, not `Unsupported`:
#. that answer would keep the change in the queue for good.
#: sync/src/services/microsoft/calendar.rs:698
msgid "Outlook cannot take a calendar off the list."
msgstr "Outlook kann einen Kalender nicht aus der Liste entfernen."

#: sync/src/services/microsoft/calendar.rs:699
msgid "Outlook cannot hide a calendar on all your devices."
msgstr "Outlook kann einen Kalender nicht auf all Ihren Geräten ausblenden."

#: sync/src/services/microsoft/calendar.rs:700
msgid "Outlook cannot subscribe to a calendar by its address."
msgstr "Outlook kann einen Kalender nicht über seine Adresse abonnieren."

#: sync/src/services/microsoft/calendar.rs:701
msgid "Outlook has no other calendars to add."
msgstr "Outlook hat keine weiteren Kalender zum Hinzufügen."

#: sync/src/services/microsoft/errors.rs:18
msgid ""
"This mailbox is on your organization's own Exchange server, which Penguin "
"Mail cannot reach."
msgstr ""
"Dieses Postfach liegt auf dem eigenen Exchange-Server Ihrer Organisation, "
"den Penguin Mail nicht erreichen kann."

#: sync/src/services/microsoft/outgoing.rs:61
msgid "The message has no Message-ID."
msgstr "Die Nachricht hat keine Message-ID."

#: sync/src/services/microsoft/outgoing.rs:74
msgid "The message cannot be read."
msgstr "Die Nachricht kann nicht gelesen werden."

#: sync/src/services/microsoft/outgoing.rs:77
msgid ""
"Microsoft cannot send a signed or encrypted message larger than 3 MB. Make "
"the files smaller or send them apart."
msgstr ""
"Microsoft kann keine signierte oder verschlüsselte Nachricht senden, die "
"größer als 3 MB ist. Verkleinern Sie die Dateien oder senden Sie sie "
"getrennt."

#: sync/src/services/microsoft/rules.rs:97
msgid "Outlook's rules cannot do that."
msgstr "Outlook-Regeln können das nicht."

#: sync/src/services/microsoft/settings.rs:169
msgid "Outlook answered but did not keep the automatic reply."
msgstr ""
"Outlook hat geantwortet, die automatische Antwort aber nicht gespeichert."

#: sync/src/services/microsoft/writes.rs:163
msgid "A folder needs a name."
msgstr "Ein Ordner braucht einen Namen."

#: sync/src/services/pop3/mod.rs:416
msgid ""
"Penguin Mail keeps the names of Inbox, Sent, Drafts, Trash, Junk and Archive."
msgstr ""
"Penguin Mail behält die Namen von Posteingang, Gesendet, Entwürfe, "
"Papierkorb, Spam und Archiv bei."

#: sync/src/services/pop3/mod.rs:432
msgid "Penguin Mail keeps Inbox, Sent, Drafts, Trash, Junk and Archive."
msgstr ""
"Penguin Mail behält Posteingang, Gesendet, Entwürfe, Papierkorb, Spam und "
"Archiv bei."

#: sync/src/services/sieve.rs:95
msgid ""
"{provider} offers no encrypted connection for rules, so Penguin Mail does "
"not send your password there."
msgstr ""
"{provider} bietet keine verschlüsselte Verbindung für Regeln an, daher "
"sendet Penguin Mail Ihr Passwort nicht dorthin."

#: sync/src/services/sieve.rs:108
msgid ""
"{provider} cannot run this rule: its server lacks the Sieve extension "
"“{extension}”."
msgstr ""
"{provider} kann diese Regel nicht ausführen: Dem Server fehlt die Sieve-"
"Erweiterung „{extension}“."

#: sync/src/services/sieve.rs:113
msgid "The folder this rule files into is not on the server yet."
msgstr ""
"Der Ordner, in den diese Regel einsortiert, existiert noch nicht auf dem "
"Server."

#: sync/src/services/sieve.rs:116
msgid "A rule on {provider} cannot keep mail out of Spam."
msgstr ""
"Eine Regel bei {provider} kann E-Mails nicht aus dem Spam heraushalten."

#: sync/src/services/sieve.rs:120
msgid "{provider} does not mark mail as important."
msgstr "{provider} markiert E-Mails nicht als wichtig."

#: sync/src/services/sieve.rs:124
msgid "A rule can file mail into one folder."
msgstr "Eine Regel kann E-Mails in einen einzigen Ordner einsortieren."

#: sync/src/services/sieve.rs:127
msgid "Say which mail the rule is for"
msgstr "Geben Sie an, für welche E-Mails die Regel gilt"

#: sync/src/services/sieve.rs:129
msgid "Choose what the rule does"
msgstr "Wählen Sie, was die Regel tut"

#: sync/src/services/sieve.rs:201
msgid "The rule is read-only."
msgstr "Die Regel ist schreibgeschützt."

#: sync/src/sign_in.rs:205
msgid "{address} is already in Penguin Mail as a {provider} account."
msgstr "{address} ist bereits als {provider}-Konto in Penguin Mail vorhanden."

#: sync/src/sign_in/browser.rs:113
msgid "You signed in as {account}. Choose {wanted} to reconnect that account."
msgstr ""
"Sie haben sich als {account} angemeldet. Wählen Sie {wanted}, um dieses "
"Konto erneut zu verbinden."

#: sync/src/sign_in/browser.rs:123
msgid ""
"Penguin Mail cannot work without access to your mail. Sign in again and "
"leave the Gmail permission ticked."
msgstr ""
"Penguin Mail kann ohne Zugriff auf Ihre E-Mails nicht funktionieren. Melden "
"Sie sich erneut an und lassen Sie die Gmail-Berechtigung angekreuzt."

#: sync/src/sign_in/browser.rs:132
msgid "Your organization's administrator must approve Penguin Mail."
msgstr "Der Administrator Ihrer Organisation muss Penguin Mail genehmigen."

#: sync/src/sign_in/browser.rs:134
msgid ""
"Penguin Mail cannot work without access to your mail. Sign in again and "
"allow it."
msgstr ""
"Penguin Mail kann ohne Zugriff auf Ihre E-Mails nicht funktionieren. Melden "
"Sie sich erneut an und erlauben Sie den Zugriff."

#: sync/src/sign_in/own_client.rs:65
msgid ""
"{set} is set but {missing} is not. Set both to sign in with your own Google "
"client, or neither to use Penguin Mail's."
msgstr ""
"{set} ist gesetzt, {missing} aber nicht. Setzen Sie beide, um sich mit Ihrem "
"eigenen Google-Client anzumelden, oder keines, um den von Penguin Mail zu "
"verwenden."

