msgstr "Ajouter l’étiquette {label}"

#: sync/src/triage.rs:61
msgid "Remove label {label}"
msgstr "Retirer l’étiquette {label}"

#: sync/src/triage.rs:64
msgid "Move out of trash"
msgstr "Sortir de la corbeille"

#: sync/src/triage.rs:65
msgid "Mark as junk"
msgstr "Marquer comme indésirable"

#: sync/src/triage.rs:66
