msgstr "Marquer comme lu"

#: sync/src/triage.rs:54
msgid "Mark unread"
msgstr "Marquer comme non lu"

#: sync/src/triage.rs:55
msgid "Star"
msgstr "Ajouter une étoile"

#: sync/src/triage.rs:56
msgid "Unstar"
msgstr "Retirer l’étoile"

